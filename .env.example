# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pastechi
DB_USER=pastechi_user
DB_PASS=your-secure-password-here

# Payload & Attachment Policy
MAX_PAYLOAD_BYTES=1048576
ATTACHMENT_MAX_BYTES=52428800
ATTACHMENT_ALLOWED_EXTENSIONS=*

# Set only when behind a CDN/proxy that overwrites this header (e.g. HTTP_AR_REAL_IP for ArvanCloud).
TRUSTED_IP_HEADER=

# Optional S3-compatible storage for encrypted attachments (e.g. ArvanCloud Object Storage).
# Paste text stays in the database. Leave empty to store attachments under storage/attachments.
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
